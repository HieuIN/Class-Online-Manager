# Copy this file to .env.production on the VPS and fill real secrets.

NODE_ENV=production
PORT=3000

# PostgreSQL runs inside docker-compose on the same VPS.
DB_HOST=postgres
DB_PORT=5432
DB_USER=ctalk
DB_PASS=change-this-long-random-db-password
DB_NAME=class_manager
DB_SSL=false

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public URLs
CORS_ORIGIN=https://ctalkchinese.com,https://www.ctalkchinese.com
FRONTEND_URL=https://ctalkchinese.com

# Uploads
UPLOAD_DIR=/app/uploads

# Forgot password email. Gmail SMTP works if you use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional AI feedback. Leave empty if not using Claude yet.
ANTHROPIC_API_KEY=

# Optional VietQR settings.
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
